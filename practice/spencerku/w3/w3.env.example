# Copy this file to .local/w3.env. Do not put credentials or private-key content here.
AWS_REGION=us-east-1
VPC_ID=vpc-replace-with-verified-id
SUBNET_ID=subnet-replace-with-verified-public-subnet
AMI_ID=ami-replace-with-verified-al2023-x86-64
SOURCE_CIDR=203.0.113.10/32
GROUP_NAME=replace-with-group
OWNER_CODE=replace-with-owner
KEY_NAME=replace-with-unique-key-name
PUBLIC_KEY_FILE=~/.ssh/w03-inspection.pub
DEPLOY_COMMIT=HEAD